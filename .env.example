# barrito environment variable overrides
# These are all optional — defaults use standard XDG/platform paths

# BARRITO_CONFIG=~/.config/barrito/config.toml
# BARRITO_STATE=~/.local/state/barrito/
# BARRITO_LOG=~/Library/Logs/barrito.log  # macOS
# BARRITO_LOG=~/.local/state/barrito/barrito.log  # Linux
# BARRITO_SHIMS=~/.local/shims/

# Test-only override (never set in production)
# BARRITO_HOME=/tmp/barrito-test

# CI-specific (set by `barrito ci` in GitHub Actions)
# BARRITO_IDENTITY=ci
# BARRITO_PORT=4141

# Platform override (for testing cross-platform behavior)
# BARRITO_PLATFORM=darwin  # or linux
